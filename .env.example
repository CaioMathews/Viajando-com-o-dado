# Configuração local do PostgreSQL. Não compartilhe este arquivo.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=viajando_com_o_dado
PGUSER=postgres
PGPASSWORD=''
PGSSLMODE=prefer

# Opcional: pasta de dados consultada pelo backend; padrão data do projeto.
# VCD_DATA_DIRECTORY=C:/caminho/para/data

# Backend: schema publicado e origens permitidas para o front.
VCD_GOLD_SCHEMA=gold
VCD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose: mantenha PGPASSWORD preenchida. PGHOST/PGPORT são definidos pela rede interna.
FRONTEND_PORT=8080
PIPELINE_YEAR=2025
# Use bronze para reaproveitar os JSONs já coletados, ou consume para consultar as APIs.
PIPELINE_START_AT=consume
